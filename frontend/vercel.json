{
  "cleanUrls": true,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "routes": [
    { "src": "/api/(.*)", "dest": "https://mytecherp-backend-69091.azurewebsites.net/api/$1" },
    { "src": "/hubs/(.*)", "dest": "https://mytecherp-backend-69091.azurewebsites.net/hubs/$1" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
