{
  "cleanUrls": true,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://mytecherp-backend-69091.azurewebsites.net/api/$1" },
    { "source": "/hubs/(.*)", "destination": "https://mytecherp-backend-69091.azurewebsites.net/hubs/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
